{
  "name": "vibe-coding-dictionary",
  "version": "1.2.0",
  "description": "바이브 코딩 백과사전의 용어 · 챕터를 찾는 플로팅 검색 위젯",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.vibecoding.dictionary",
    "productName": "Vibe Coding Dictionary",
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "widget.html",
      "assets/**"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "VibeCodingDictionary-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education"
    },
    "publish": null,
    "dmg": {
      "artifactName": "VibeCodingDictionary-${version}-mac-${arch}.${ext}"
    }
  }
}
